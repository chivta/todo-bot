# Telegram bot token from @BotFather.
BOT_TOKEN=123456:ABC-DEF

# Telegram user IDs allowed to use the bot, comma separated. Leave empty to
# allow anyone who finds the bot to use it — and spend your API budget.
ALLOWED_USERS=

# Claude API key and model. claude-haiku-4-5 is the cheapest model the API
# offers ($1/$5 per million tokens) and is what list building runs on.
CLAUDE_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-haiku-4-5

# Voice messages are transcribed with OpenAI; Claude models take no audio.
OPENAI_API_KEY=sk-xxx
TRANSCRIBE_MODEL=whisper-1

# Alternative hosts for the three services the bot talks to. All empty in
# production; the offline suite points them at fakes so it needs no network and
# no API budget.
TELEGRAM_API_URL=
CLAUDE_API_URL=
OPENAI_API_URL=

# Local state. Belongs on persistent storage in the cluster.
DB_PATH=data/todobot.db

# Health and metrics endpoints.
HTTP_ADDR=:8080

# debug | info | warn | error
LOG_LEVEL=info

# Concurrent jobs across all users.
WORKERS=3

# Pending jobs accepted before new requests are rejected.
QUEUE_SIZE=64

# Per-user token bucket refill, in requests per hour.
USER_RATE_PER_HOUR=120

# Per-user burst allowance and maximum queued jobs for one user.
USER_BURST=5

# Maximum time allowed for one request, transcription included.
JOB_TIMEOUT=2m
